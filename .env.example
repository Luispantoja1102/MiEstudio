# Copia este archivo a .env (cp .env.example .env). El .env NO se sube a git.
# ── Aplicación ─────────────────────────────────────────────────────────────
APP_ENV=development            # en producción usa: production
GO_API_PORT=8080
NODE_API_PORT=3000
JWT_SECRET=cambia_esto_por_un_secreto_largo_de_32_caracteres_o_mas

# ── Base de datos ──────────────────────────────────────────────────────────
POSTGRES_USER=miestudio
POSTGRES_PASSWORD=change_me
POSTGRES_DB=miestudio
DATABASE_URL=postgres://miestudio:change_me@localhost:5432/miestudio?sslmode=disable

# ── Administrador de la plataforma (admin general) ─────────────────────────
# Al arrancar la API se crea esta cuenta si todavía no existe ningún administrador
# de plataforma. Con ella entras en /login y te lleva a /plataforma (negocios,
# aprobaciones, equipo, actividad y ajustes de registro).
#
# Estos valores sirven para PRUEBAS LOCALES. En producción cámbialos:
# con APP_ENV=production la API se niega a usar la clave de ejemplo.
PLATFORM_ADMIN_NAME=Administrador
PLATFORM_ADMIN_EMAIL=admin@miestudio.local
PLATFORM_ADMIN_PASSWORD=AdminPlataforma123
#
# Crear otro administrador o restablecer una contraseña olvidada, en cualquier momento:
#   npm run admin -- -email otra@persona.com -password 'ClaveLarga123' -name 'Nombre'
