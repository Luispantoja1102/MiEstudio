# Copia este archivo a .env (cp .env.example .env). El .env NO se sube a git.
# ── Aplicación ─────────────────────────────────────────────────────────────
APP_ENV=development            # en producción usa: production
GO_API_PORT=8080
NODE_API_PORT=3000
JWT_SECRET=cambia_esto_por_un_secreto_largo_de_32_caracteres_o_mas

# ── Base de datos ──────────────────────────────────────────────────────────
POSTGRES_USER=miestudio
POSTGRES_PASSWORD=change_me
POSTGRES_DB=miestudio
DATABASE_URL=postgres://miestudio:change_me@localhost:5432/miestudio?sslmode=disable

# ── Administrador de la plataforma (admin general) ─────────────────────────
# Al arrancar la API se crea esta cuenta si todavía no existe ningún administrador
# de plataforma. Con ella entras en /login y te lleva a /plataforma (negocios,
# aprobaciones, equipo, actividad y ajustes de registro).
#
# Estos valores sirven para PRUEBAS LOCALES. En producción cámbialos:
# con APP_ENV=production la API se niega a usar la clave de ejemplo.
PLATFORM_ADMIN_NAME=Administrador
PLATFORM_ADMIN_EMAIL=admin@miestudio.local
PLATFORM_ADMIN_PASSWORD=AdminPlataforma123
#
# Crear otro administrador o restablecer una contraseña olvidada, en cualquier momento:
#   npm run admin -- -email otra@persona.com -password 'ClaveLarga123' -name 'Nombre'

# ── Cobro con terminal Mercado Pago (Point) ────────────────────────────────
# Cada negocio conecta SU cuenta de Mercado Pago con OAuth desde el panel (Pagos → Conectar con
# Mercado Pago). Para eso la plataforma necesita UNA aplicación de Mercado Pago registrada
# (Mercado Pago → Tus integraciones → Crear aplicación):
#   - Redirect URL de la aplicación:  <API_PUBLIC_URL>/api/point/oauth/callback
#     Debe coincidir letra por letra con MP_OAUTH_REDIRECT.
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# Dirección pública del servidor, con o sin el sufijo /api. Ejemplo: https://tudominio.mx
API_PUBLIC_URL=
# Si la omites se usa  <API_PUBLIC_URL>/api/point/oauth/callback
MP_OAUTH_REDIRECT=
# País de la cuenta (por defecto México): https://auth.mercadopago.com.mx
# MP_AUTH_BASE=

# Claves PROPIAS de tu servidor (no son de Mercado Pago). Ambas son opcionales:
#   TOKEN_ENC_KEY       cifra en la base de datos los tokens de Mercado Pago de cada negocio.
#   OAUTH_STATE_SECRET  firma el enlace de retorno del OAuth, para que nadie pueda fabricar uno
#                       que conecte una cuenta de Mercado Pago a un negocio ajeno.
# Si las omites se derivan de JWT_SECRET y todo funciona. Si las defines, 64 caracteres
# hexadecimales (openssl rand -hex 32) o base64 de 32 bytes. Si cambias TOKEN_ENC_KEY (o JWT_SECRET
# cuando no la defines) los negocios tendrán que volver a conectar Mercado Pago.
# TOKEN_ENC_KEY=
# OAUTH_STATE_SECRET=

# Correo saliente (confirmación, cambios, cancelación y recordatorios de la reserva en línea).
# Sin SMTP_HOST y MAIL_FROM no se envía nada y la app funciona igual.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USER=tu@gmail.com y una "contraseña de aplicación" en SMTP_PASS.
# Puerto 587 usa STARTTLS (por defecto); con SMTP_SECURE=true se usa TLS directo en el 465.
# No se mandan credenciales por una conexión sin cifrar.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=MiEstudio <no-reply@tu-dominio.mx>
# Dirección pública de la app: los correos enlazan a APP_URL/cita/<enlace privado>.
# APP_URL=https://tu-dominio.mx

# Anticipos de la reserva en línea: Mercado Pago avisa cada pago a API_PUBLIC_URL/api/webhooks/mercadopago.
# Si defines MP_WEBHOOK_SECRET (la «clave secreta» de Webhooks en tu aplicación de Mercado Pago) se exige
# la firma de cada aviso. Sin avisos el sistema igual confirma pagos al volver el cliente a su enlace y al
# vencer el apartado de 15 minutos.
# MP_WEBHOOK_SECRET=

# Reservadas para cuando la plataforma cobre suscripciones con su propia cuenta de Mercado Pago.
# Todavía no se usan:
# MPP_ACCESS_TOKEN=
# MPP_PUBLIC_KEY=

# Solo para pruebas con un servidor simulado; vacío usa https://api.mercadopago.com
# MP_API_BASE=
